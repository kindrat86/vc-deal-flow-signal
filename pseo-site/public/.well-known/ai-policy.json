    "/api/oauth/",
    "/api/webhook/",
    "/api/cron/",
    "/api/verify/",
    "/dashboard/",
    "/login/",
    "/welcome/",
    "/share/",
    "/predicted/"
  ],
  "preferredFormats": {
    "llmsIndex": "https://signals.gitdealflow.com/llms.txt",
    "llmsFull": "https://signals.gitdealflow.com/llms-full.txt",
    "markdownMirror": "https://signals.gitdealflow.com/md/",

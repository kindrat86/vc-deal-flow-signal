  "permissions": {
    "training": "allow",
    "answer": "allow",
    "citation": "required",
    "summarization": "allow",
    "embedding": "allow",
    "fineTune": "allow",
    "commercialBulkRedistribution": "contact"
  },
  "agents": {
    "GPTBot": { "training": "allow", "answer": "allow" },
    "ChatGPT-User": { "answer": "allow" },
    "OAI-SearchBot": { "answer": "allow" },
    "ClaudeBot": { "training": "allow", "answer": "allow" },
    "Claude-Web": { "answer": "allow" },
    "Claude-User": { "answer": "allow" },
    "Claude-SearchBot": { "answer": "allow" },
    "anthropic-ai": { "training": "allow" },
    "PerplexityBot": { "answer": "allow", "citation": "required" },
    "Perplexity-User": { "answer": "allow" },
    "Google-Extended": { "training": "allow", "answer": "allow" },
    "GoogleOther": { "answer": "allow" },
    "Applebot": { "answer": "allow" },
    "Applebot-Extended": { "training": "allow" },
    "CCBot": { "training": "allow" },
    "Bytespider": { "training": "allow", "answer": "allow" },
    "Amazonbot": { "answer": "allow" },
    "cohere-ai": { "training": "allow", "answer": "allow" },
    "Meta-ExternalAgent": { "training": "allow", "answer": "allow" },
    "Meta-ExternalFetcher": { "answer": "allow" },
    "MistralAI-User": { "answer": "allow" },
    "DuckAssistBot": { "answer": "allow" },
    "YouBot": { "answer": "allow" },
    "Diffbot": { "training": "allow" },
    "Kagibot": { "answer": "allow" }

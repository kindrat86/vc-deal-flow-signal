          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://*.posthog.com https://www.googletagmanager.com https://snap.licdn.com; connect-src 'self' https://api.github.com https://*.posthog.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://signals.gitdealflow.com; frame-ancestors 'self' https: https://sipi.bot https://*.gitdealflow.com"
        },

{
  "outputDirectory": ".",
  "buildCommand": "node scripts/verify-jsonld.mjs .",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/es",
      "destination": "/es/index.html"
    },
    {
      "source": "/de",
      "destination": "/de/index.html"
    },
    {
      "source": "/es/:path*",
      "destination": "/es/:path*/index.html"
    },
    {
      "source": "/de/:path*",
      "destination": "/de/:path*/index.html"
    },
    {
      "source": "/mcp",
      "destination": "/mcp.html"
    },
    {
      "source": "/embed",
      "destination": "/embed.html"
    },
    {
      "source": "/embed/tools/:slug",
      "destination": "/embed/tools/:slug.html"
    },
    {
      "source": "/feed.xml",
      "destination": "https://signals.gitdealflow.com/feed.xml"
    },
    {
      "source": "/knowledge-graph.json",
      "destination": "https://signals.gitdealflow.com/knowledge-graph.json"
    },
    {
      "source": "/qa.jsonl",
      "destination": "https://signals.gitdealflow.com/qa.jsonl"
    },
    {
      "source": "/.well-known/llms.txt",
      "destination": "https://signals.gitdealflow.com/.well-known/llms.txt"
    },
    {
      "source": "/.well-known/llms-full.txt",
      "destination": "https://signals.gitdealflow.com/.well-known/llms-full.txt"
    },
    {
      "source": "/.well-known/ai.txt",
      "destination": "https://signals.gitdealflow.com/.well-known/ai.txt"
    },
    {
      "source": "/.well-known/agents.json",
      "destination": "https://signals.gitdealflow.com/.well-known/agents.json"
    },
    {
      "source": "/.well-known/agent-card.json",
      "destination": "https://signals.gitdealflow.com/.well-known/agent-card.json"
    },
    {
      "source": "/.well-known/openapi.json",
      "destination": "https://signals.gitdealflow.com/.well-known/openapi.json"
    },
    {
      "source": "/.well-known/ai-plugin.json",
      "destination": "https://signals.gitdealflow.com/.well-known/ai-plugin.json"
    },
    {
      "source": "/.well-known/ai-policy.json",
      "destination": "https://signals.gitdealflow.com/.well-known/ai-policy.json"
    },
    {
      "source": "/.well-known/freshness.json",
      "destination": "https://signals.gitdealflow.com/.well-known/freshness.json"
    },
    {
      "source": "/.well-known/openai-search.json",
      "destination": "https://signals.gitdealflow.com/.well-known/openai-search.json"
    },
    {
      "source": "/.well-known/tdm-reservation.json",
      "destination": "https://signals.gitdealflow.com/.well-known/tdm-reservation.json"
    },
    {
      "source": "/.well-known/dataset.json",
      "destination": "https://signals.gitdealflow.com/.well-known/dataset.json"
    },
    {
      "source": "/.well-known/skills.json",
      "destination": "https://signals.gitdealflow.com/.well-known/skills.json"
    },
    {
      "source": "/.well-known/security.txt",
      "destination": "https://signals.gitdealflow.com/.well-known/security.txt"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.gitdealflow.com"
        }
      ],
      "destination": "https://gitdealflow.com/:path*",
      "permanent": true
    },
    {
      "source": "/AGENTS.md",
      "destination": "/agents.md",
      "permanent": true
    },
    {
      "source": "/predicted",
      "destination": "https://signals.gitdealflow.com/predicted",
      "permanent": true
    },
    {
      "source": "/book",
      "destination": "https://signals.gitdealflow.com/book",
      "permanent": true
    },
    {
      "source": "/g2",
      "destination": "https://www.g2.com/products/gitdealflow/reviews",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/((?!.*\\.).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|webp|svg|ico|gif|mp4|jpg|jpeg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/(.*).xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400"
        },
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(llms|llms-full|ai|agents|humans).txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/.well-known/security.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://*.posthog.com; connect-src 'self' https://*.posthog.com https://signals.gitdealflow.com; frame-ancestors 'self' https: https://sipi.bot https://*.gitdealflow.com"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        }
      ]
    },
    {
      "source": "/embed(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}

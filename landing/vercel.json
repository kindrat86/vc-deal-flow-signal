{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/AGENTS.md", "destination": "/agents.md" },
    { "source": "/.well-known/agents.md", "destination": "/agents.md" },
    { "source": "/.well-known/llms.txt", "destination": "/llms.txt" },
    { "source": "/.well-known/ai.txt", "destination": "/ai.txt" }
  ],
  "redirects": [
    { "source": "/.well-known/mcp.json",            "destination": "https://signals.gitdealflow.com/.well-known/mcp.json",            "permanent": false },
    { "source": "/.well-known/agent-card.json",     "destination": "https://signals.gitdealflow.com/.well-known/agent-card.json",     "permanent": false },
    { "source": "/.well-known/ai-plugin.json",      "destination": "https://signals.gitdealflow.com/.well-known/ai-plugin.json",      "permanent": false },
    { "source": "/.well-known/ai-policy.json",      "destination": "https://signals.gitdealflow.com/.well-known/ai-policy.json",      "permanent": false },
    { "source": "/.well-known/api-catalog",         "destination": "https://signals.gitdealflow.com/.well-known/api-catalog",         "permanent": false },
    { "source": "/knowledge-graph.json",            "destination": "https://signals.gitdealflow.com/knowledge-graph.json",            "permanent": false },
    { "source": "/qa.jsonl",                        "destination": "https://signals.gitdealflow.com/qa.jsonl",                        "permanent": false },
    { "source": "/feed.xml",                        "destination": "https://signals.gitdealflow.com/feed.xml",                        "permanent": false },
    { "source": "/api/openapi.json",                "destination": "https://signals.gitdealflow.com/api/openapi.json",                "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/agents.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" },
        { "key": "Link", "value": "<https://gitdealflow.com/agents.md>; rel=\"canonical\", <https://ssrn.com/abstract=6606558>; rel=\"cite-as\"" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" },
        { "key": "Link", "value": "<https://gitdealflow.com/llms-full.txt>; rel=\"alternate\"; type=\"text/plain\", <https://ssrn.com/abstract=6606558>; rel=\"cite-as\"" }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" },
        { "key": "Link", "value": "<https://gitdealflow.com/llms.txt>; rel=\"alternate\"; type=\"text/plain\", <https://ssrn.com/abstract=6606558>; rel=\"cite-as\"" }
      ]
    },
    {
      "source": "/ai.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/agents.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/.well-known/security.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/sitemap-pages.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}

# cron-auth.env — unattended auth for the launchd cron jobs (run-daily.sh /
# run-engagement.sh). Copy this file to `cron-auth.env` (same dir) and fill in a
# long-lived token. cron-auth.env is gitignored; this .example is committed.
#
# Why: launchd background agents can't reliably unlock the macOS login Keychain,
# and the interactive OAuth *login* token expires without persisting a refresh
# to disk for headless runs. A `claude setup-token` token sidesteps both.
#
# Generate the token (interactive, one time):
#     claude setup-token
# Copy the printed value (starts with sk-ant-oat01-...) into the line below,
# then: chmod 600 cron-auth.env
#
# The token is long-lived but not permanent — if the cron starts 401ing again,
# re-run `claude setup-token` and replace the value.

CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-REPLACE_ME
